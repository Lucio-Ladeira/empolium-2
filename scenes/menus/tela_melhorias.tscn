[sub_resource type="Shader" id="Shader_fundo_transparente"]
code = "shader_type canvas_item;

void fragment() {
	vec4 arte = texture(TEXTURE, UV);
	vec2 pixel = UV / TEXTURE_PIXEL_SIZE;
	// Preserva os textos pretos dentro do visor desta arte de 960 x 540.
	bool dentro_do_visor = pixel.x >= 342.0 && pixel.x < 561.0 && pixel.y >= 360.0 && pixel.y < 469.0;
	bool janela_animada = pixel.x >= 292.0 && pixel.x < 668.0 && pixel.y >= 16.0 && pixel.y < 264.0;
	if (janela_animada) {
		arte.a = 0.0;
	} else if (!dentro_do_visor && max(max(arte.r, arte.g), arte.b) < 0.01) {
		arte.a = 0.0;
	}
	COLOR = arte;
}
"

