[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://os/apps/settings/settings.gd" id="1"]
[sub_resource type="StyleBoxFlat" id="line"]
bg_color = Color(0.045, 0.065, 0.12, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.19, 0.32, 0.48, 1)

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 22.0
offset_top = 18.0
offset_right = -22.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Configurações"
theme_override_colors/font_color = Color(0.91, 0.96, 1, 1)
theme_override_font_sizes/font_size = 22

[node name="Description" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Ajuste o ambiente ao seu gosto."
theme_override_colors/font_color = Color(0.68, 0.79, 0.9, 1)

[node name="Separator" type="HSeparator" parent="Margin/Content"]
layout_mode = 2

[node name="SystemHeading" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "SISTEMA"
theme_override_colors/font_color = Color(0.45, 0.81, 0.9, 1)
theme_override_font_sizes/font_size = 12

[node name="LanguageLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Idioma da interface"
theme_override_font_sizes/font_size = 13

[node name="Language" type="OptionButton" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
theme_override_styles/normal = SubResource("line")

[node name="LanguageNote" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Idioma atual: Português (Brasil)"
theme_override_colors/font_color = Color(0.5, 0.64, 0.79, 1)

[node name="Fullscreen" type="CheckButton" parent="Margin/Content"]
layout_mode = 2
text = "Tela cheia"

[node name="AudioHeading" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "ÁUDIO"
theme_override_colors/font_color = Color(0.45, 0.81, 0.9, 1)
theme_override_font_sizes/font_size = 12

[node name="VolumeLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Volume principal"

[node name="Volume" type="HSlider" parent="Margin/Content"]
